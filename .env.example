# =========================
# KONGGEST - Environment Variables
# =========================

# --- General ---
APP_NAME=konggest
ENVIRONMENT=development

# --- Django Backend ---
DJANGO_SECRET_KEY=change-me-to-a-secure-random-string-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,konggest-backend
DJANGO_CORS_ALLOWED_ORIGINS=https://localhost,https://127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# --- Supabase / PostgreSQL ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:postgres@konggest-db:5432/konggest
POSTGRES_DB=konggest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# --- Redis ---
REDIS_URL=redis://konggest-redis:6379/0

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Encryption (AES-256) ---
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-key

# --- Next.js Frontend ---
NEXT_PUBLIC_API_URL=https://localhost/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_APP_NAME=Konggest
NEXT_PUBLIC_APP_URL=https://konggest.vercel.app

# =========================
# Production (Vercel + Render)
# =========================
# NEXT_PUBLIC_API_URL=https://konggest-api.onrender.com/api
# NEXT_PUBLIC_APP_URL=https://konggest.vercel.app
# DJANGO_CORS_ALLOWED_ORIGINS=https://konggest.vercel.app
# DJANGO_ALLOWED_HOSTS=konggest-api.onrender.com
# DJANGO_SETTINGS_MODULE=config.settings.production
